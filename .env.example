# Copy to .env and fill in. Never commit the real .env file.

# --- Server ---
PORT=8080

# --- Database (docker-compose sets DATABASE_URL/USER/PASSWORD itself for the app
# container to point at the postgres service; DATABASE_PASSWORD here also seeds
# the postgres container's own password, so set it once and it's used by both) ---
DATABASE_PASSWORD=change-me-strong-password

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ISSUER=numerology-backend
JWT_AUDIENCE=numerology-app

# --- Field-level encryption for birth dates (AES-256, must be exactly 32 bytes base64) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me

# --- Admin (protects PUT /admin/config/{key}) ---
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me

# --- LLM (OpenAI) ---
# Get a key at https://platform.openai.com/api-keys (requires a funded account —
# free trial credits are small/one-time, see chat notes). Without this set, every
# daily insight silently falls back to the pre-written bank (fallback_insights.json)
# instead of erroring — safe to deploy without it for a first smoke test.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=12000

# --- Scheduler ---
# A 30-minute sweep checks every user against these hours in THEIR OWN local
# time (profile `timezone`, see SaveProfileRequest — an IANA zone id like
# "Asia/Tashkent" or a fixed offset like "+05:00"; anything java.time.ZoneId
# accepts). SCHEDULER_TIMEZONE below is only the fallback for users who never
# set one. Nightly batch pre-generates tomorrow's insight once their local
# clock hits NIGHTLY_BATCH_HOUR; daily push sends today's headline once it
# hits DAILY_PUSH_HOUR (both dedup per user+date, so the 30-min sweep cadence
# won't double-send).
NIGHTLY_BATCH_HOUR=3
DAILY_PUSH_HOUR=9
SCHEDULER_TIMEZONE=Asia/Tashkent

# --- Google Play (subscriptions) + Firebase Cloud Messaging (push) ---
# Both are service-account JSON key files. Mount them into the app container via
# ./secrets/ (see docker-compose.yml) and point the *_PATH vars at the in-container
# path, e.g. /app/secrets/google-play-service-account.json

# 1) Google Play Console -> Setup -> API access -> link/create a Google Cloud project
#    and service account for this app.
# 2) In Play Console, grant that service account the "View financial data, orders,
#    and cancellation survey responses" + "Manage orders and subscriptions"
#    permissions for this specific app.
# 3) In Google Cloud Console -> IAM & Admin -> Service Accounts -> (the account) ->
#    Keys -> Add key -> JSON -> download. That file is GOOGLE_PLAY_SERVICE_ACCOUNT_JSON.
# 4) GOOGLE_PLAY_PACKAGE_NAME is the Android app id, e.g. com.yourcompany.numerology.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/app/secrets/google-play-service-account.json
GOOGLE_PLAY_PACKAGE_NAME=

# 5) (Optional, for renewals/cancellations to update automatically) Google Play
#    Console -> Monetization setup -> Real-time developer notifications -> create/
#    link a Pub/Sub topic. Then in Google Cloud Console -> Pub/Sub -> Subscriptions,
#    create a PULL subscription on that topic (pull works over plain HTTP outbound,
#    no public HTTPS endpoint needed — unlike push, which Google requires HTTPS for).
#    Grant the same service account the "Pub/Sub Subscriber" role on it.
#    Format: projects/<gcp-project-id>/subscriptions/<subscription-name>
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_CLOUD_PROJECT_ID=

# 6) Firebase Console -> Project settings (gear icon) -> Service accounts tab ->
#    "Generate new private key". That downloaded file is FIREBASE_SERVICE_ACCOUNT_JSON.
#    GOOGLE_CLOUD_PROJECT_ID (same field, shared with Pub/Sub above if it's the same
#    GCP project as your Firebase project, which it usually is) is on the same page.
#    Also add the iOS/Android apps to that Firebase project so their push tokens are
#    valid FCM send targets.
FIREBASE_SERVICE_ACCOUNT_JSON=/app/secrets/firebase-service-account.json

# --- Apple (subscriptions) — stubbed for now, structure is ready ---
# The backend can already receive and idempotently store Apple App Store Server
# Notifications V2 (POST /webhooks/apple), but does NOT yet cryptographically verify
# the JWS signature (see AppleJwsDecoder.kt) — safe to test with, not yet safe to
# trust for money-sensitive entitlement decisions.
# When ready:
# 1) App Store Connect -> Users and Access -> Integrations -> In-App Purchase ->
#    generate an App Store Server API key (.p8 file) -> note the Key ID and Issuer ID.
# 2) App Store Connect -> your app -> App Information -> App Store Server
#    Notifications -> set the Production and Sandbox URLs to
#    https://<your-domain>/webhooks/apple (requires HTTPS + a real domain — the
#    server currently only has an IP, see chat notes about adding a domain later).
# 3) Mount the .p8 file the same way as the Google JSON files above.
APPLE_PRIVATE_KEY_PATH=/app/secrets/apple-app-store-server.p8
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_BUNDLE_ID=
